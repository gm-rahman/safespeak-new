# Browser traffic is routed through the backend, including AI and RAG.
# The backend privately delegates model and embedding work to the FastAPI agent.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_AI_AGENT_API_BASE_URL=http://localhost:8000/api/v1

SAFESPEAK_BACKEND_ORIGIN=http://localhost:5000

# Optional browser-side Google Maps integration.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
